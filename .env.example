# Copiază acest fișier ca .env.local și completează valorile din
# Firebase Console → Project settings → General → Your apps → SDK setup and configuration (Config).
# Fără aceste valori, aplicația salvează datele doar în browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
